<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>Arrkit</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- ILogger for Arrkit.Logging. A framework reference, not a package, so central package
             management (Muxarr) is not involved. Every app using arrkit is an ASP.NET Core app. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
